# ProSe Navigator — environment variables
#
# Copy the values you need into your runtime's environment (Repl Secrets in
# development). Variables are grouped by the runtime that reads them. Secrets
# (API keys, DB passwords, service-role keys) MUST stay server-side — never put
# a secret behind an EXPO_PUBLIC_ or NEXT_PUBLIC_ prefix, which ships to the
# client bundle.
#
# Legend:  [required]  the runtime won't work without it
#          [optional]  has a sensible default or degrades gracefully

# ======================================================================
# API server  (artifacts/api-server) — Express AI router + legal retrieval
# ======================================================================

# Anthropic — the Navigator (chat) and drafting models.            [required]
ANTHROPIC_API_KEY=

# Perplexity Sonar — live web research + second-source citation check.
PERPLEXITY_API_KEY=                                              # [required for research/verify]
PERPLEXITY_MODEL=sonar-pro                                       # [optional] override the Sonar model

# CourtListener — primary citation verification (v4 citation-lookup). [required for verify]
COURTLISTENER_API_TOKEN=

# Supabase — server-side token verification (auth middleware).
SUPABASE_URL=                                                    # [required if auth enabled]
SUPABASE_ANON_KEY=                                               # [required if auth enabled]

# Database (legal corpus retrieval). First non-empty wins:
#   1) SUPABASE_POOLER_URL  — Supabase session pooler (IPv4, preferred)
#   2) DATABASE_URL         — Replit built-in Postgres
#   3) SUPABASE_DB_PASSWORD — legacy full postgresql:// URL (fallback)
SUPABASE_POOLER_URL=                                             # [required for retrieval]
DATABASE_URL=
SUPABASE_DB_PASSWORD=

# Security posture. In production set BOTH to "true" so the paid AI and
# retrieval endpoints reject unauthenticated traffic.               [important]
AI_REQUIRE_AUTH=false
RETRIEVAL_REQUIRE_AUTH=false

# CORS allowlist (comma-separated origins). Empty = permissive (dev only).
CORS_ALLOWED_ORIGINS=

# Runtime.
PORT=                                                            # [required] port to listen on
NODE_ENV=development                                             # [optional] production | development
LOG_LEVEL=info                                                  # [optional] pino level

# ======================================================================
# Mobile app  (artifacts/pro-se-navigator) — Expo. EXPO_PUBLIC_* only.
# These are compiled into the client bundle — never put a secret here.
# ======================================================================

EXPO_PUBLIC_SUPABASE_URL=                                        # [required]
EXPO_PUBLIC_SUPABASE_ANON_KEY=                                   # [required] anon key (RLS enforces access)

# API server base URL. If unset, the app derives it from EXPO_PUBLIC_DOMAIN.
EXPO_PUBLIC_API_URL=                                             # [required — persist as a Secret]
EXPO_PUBLIC_DOMAIN=                                             # [optional] Replit dev domain fallback

# ======================================================================
# Website  (artifacts/navigator-web) — Next.js
# NEXT_PUBLIC_* ships to the browser; everything else is server-only.
# ======================================================================

NEXT_PUBLIC_SUPABASE_URL=                                        # [required]
NEXT_PUBLIC_SUPABASE_ANON_KEY=                                   # [required] anon key (RLS enforces access)

# Server-only (API routes): reuses the same keys as the API server.
ANTHROPIC_API_KEY=                                               # [required] (server-side)
COURTLISTENER_API_TOKEN=                                         # [required for verify] (server-side)
PERPLEXITY_API_KEY=                                              # [optional] second-source check (server-side)
PERPLEXITY_MODEL=sonar-pro                                       # [optional]
# SUPABASE_SERVICE_ROLE_KEY — reserved for Storage/admin server actions; never
# expose to the client. (Not yet read by code; add when Storage lands.)
SUPABASE_SERVICE_ROLE_KEY=
